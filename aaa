stage:
    backdrop White("gallery:General/White")

    actor LogiRobi:
        costume LogiRobi_Idle("gallery:Figures/Robot Idle")

        def TriangleRow(vol):
            pen.shade = 30
            for i in range(0, vol): 
                pen.hue = 0
                Triangle()
                move(24)
                turnLeft(60)
                pen.hue = 66
                Triangle()
                turnRight(60)

        def Triangle():
            pen.down()
            side = 3
            for i in range(0, side): 
                move(side * 8)
                turnLeft(360 / side)
            pen.up()

        when keyPressed("space"):
            clearPenTrails()
            xval = 10
            maxnum = xval + 1
            x_pos = -140
            y_pos = -140
            for i in range(0, maxnum): 
                setPosition(x_pos, y_pos)
                heading = 90
                TriangleRow(xval)
                pen.hue = 0
                Triangle()
                x_pos += 12
                y_pos += 21
                xval -= 1

        when started:
            hide()
            pen.size = 2
